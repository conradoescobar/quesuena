# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Auth - Spotify Provider
# Configure these in your Supabase Dashboard > Authentication > Providers > Spotify
# You'll need to create a Spotify Developer App at https://developer.spotify.com/dashboard

# Spotify API Credentials (for Client Credentials flow - guest search)
# Get these from your Spotify Developer App at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional: For server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# YouTube API Key (for audio playback - free alternative to Spotify Premium)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project
YOUTUBE_API_KEY=your_youtube_api_key
